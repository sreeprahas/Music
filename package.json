{
  "name": "music",
  "private": true,
  "version": "1.0.0",
  "main": "electron-main.js",
  "homepage": "./",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "electron:build": "npm run build",
    "electron:run": "concurrently \"npm run start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron": "npm run build && concurrently \"npm run start\" \"wait-on http://localhost:3000 && electron .\""
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.19",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^43.4.0",
    "electron-is-dev": "^3.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.3",
    "wait-on": "^7.1.0"
