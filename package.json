{
  "name": "music",
  "productName": "Music",
  "description": "Your library. Downloaded. Yours.",
  "author": "Prahas",
  "private": true,
  "version": "1.0.0",
  "main": "electron-main.js",
  "homepage": "./",
  "build": {
    "appId": "com.prahas.music",
    "productName": "Music",
    "icon": "public/music-icon.png",
    "files": [
      "**/*",
      "!data/**",
      "!dist/**",
      "!.git/**",
      "!.next/cache/**",
      "!.next/standalone/data/**",
      "!node_modules/electron-builder/**",
      "!node_modules/app-builder-lib/**"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Music",
      "include": "electron-builder-uninstall.nsh"
    }
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "electron:build": "npm run build",
    "electron:run": "electron .",
    "electron": "npm run build && electron .",
    "electron:package:win": "npm run build && electron-builder --win",
    "electron:package:nobuild:win": "electron-builder --win"
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.19",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.3",
    "wait-on": "^7.1.0"
  }
}
