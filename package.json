{
  "name": "youtube-music-personal",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "neutralino:dev": "concurrently \"npm run dev\" \"npx @neutralinojs/neu run\"",
    "neutralino:run": "concurrently \"npm run start\" \"npx @neutralinojs/neu run\"",
    "neutralino:build": "npx @neutralinojs/neu build",
    "neutralino:prepare": "node scripts/prepare-neutralino.js",
    "neutralino:build:full": "npm run build && npm run neutralino:prepare && npx @neutralinojs/neu build",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@neutralinojs/lib": "^6.9.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/express": "^4.17.19",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.3"
  }
}
