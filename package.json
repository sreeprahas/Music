{
  "name": "music",
  "productName": "Music",
  "description": "Your library. Downloaded. Yours.",
  "author": "Prahas",
  "private": true,
  "version": "1.0.0",
  "main": "electron-main.js",
  "homepage": "./",
  "build": {
    "appId": "com.prahas.music",
    "productName": "Music",
    "icon": "public/music-icon.png",
    "files": [
      "**/*",
      "!data/**",
      "!dist/**",
      "!.git/**",
      "!.next/cache/**",
      "!.next/standalone/data/**",
      "!node_modules/electron-builder/**",
      "!node_modules/app-builder-lib/**",
      "!.venv/**",
      "!.venv-legacy/**",
      "!services/.build/**"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Music",
      "include": "electron-builder-uninstall.nsh"
    }
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "electron:build": "npm run build",
    "electron:run": "electron .",
    "electron:dev": "electron . --dev",
    "electron": "npm run build && electron .",
    "spotify:poc": "electron electron/spotify/spotify-poc.cjs",
    "electron:package": "npm run build && electron-builder --win",
    "electron:package:nobuild": "electron-builder --win",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "lucide-react": "^0.475.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.34.5",
    "transliteration": "^2.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.8.1",
    "typescript": "^5.7.3"
  }
}
