  file_change {
    absolute_path_uri: "file:///src/context/AuthContext.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { createContext, useContext, useEffect, useState } from \'react\';\nimport { UserSession } from \'../types\';\n\ninterface AuthContextType {\n  user: UserSession | null;\n  authorizedEmail: string;\n  loading: boolean;\n  error: string | null;\n  quickLogin: (email?: string) => Promise<boolean>;\n  googleLogin: (email: string, name?: string, image?: string) => Promise<boolean>;\n  logout: () => Promise<void>;\n  clearError: () => void;\n}\n\nconst AuthContext = createContext<AuthContextType | undefined>(undefined);\n\nexport const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [user, setUser] = useState<UserSession | null>(null);\n  const [authorizedEmail, setAuthorizedEmail] = useState<string>(\'minecraftprahas@gmail.com\');\n  const [loading, setLoading] = useState<boolean>(true);\n  const [error, setError] = useState<string | null>(null);\n\n  const checkSession = async () => {\n    try {\n      setLoading(true);\n      const res = await fetch(\'/api/auth/session\');\n      const data = await res.json();\n\n      if (data.authorizedEmail) {\n        setAuthorizedEmail(data.authorizedEmail);\n      }\n\n      if (data.user && data.user.isAuthorized) {\n        setUser(data.user);\n      } else {\n        setUser(null);\n      }\n    } catch (err) {\n      console.error(\'Session check failed:\', err);\n      setUser(null);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    checkSession();\n  }, []);\n\n  const quickLogin = async (emailInput?: string): Promise<boolean> => {\n    try {\n      setError(null);\n      const res = await fetch(\'/api/auth/quick-auth\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ email: emailInput || authorizedEmail }),\n      });\n      const data = await res.json();\n\n      if (!res.ok || !data.success) {\n        setError(data.message || \'Authentication failed. Check your authorized email.\');\n        return false;\n      }\n\n      setUser(data.user);\n      return true;\n    } catch (err: any) {\n      setError(\'Network error during authentication.\');\n      return false;\n    }\n  };\n\n  const googleLogin = async (email: string, name?: string, image?: string): Promise<boolean> => {\n    try {\n      setError(null);\n      const res = await fetch(\'/api/auth/google-login\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ email, name, image }),\n      });\n      const data = await res.json();\n\n      if (!res.ok || !data.success) {\n        setError(data.message || `Access denied. Only ${authorizedEmail} is permitted.`);\n        return false;\n      }\n\n      setUser(data.user);\n      return true;\n    } catch (err) {\n      setError(\'Failed to authenticate with Google OAuth.\');\n      return false;\n    }\n  };\n\n  const logout = async () => {\n    try {\n      await fetch(\'/api/auth/logout\', { method: \'POST\' });\n    } catch (e) {\n      // ignore\n    } finally {\n      setUser(null);\n    }\n  };\n\n  const clearError = () => setError(null);\n\n  return (\n    <AuthContext.Provider\n      value={{\n        user,\n        authorizedEmail,\n        loading,\n        error,\n        quickLogin,\n        googleLogin,\n        logout,\n        clearError,\n      }}\n    >\n      {children}\n    </AuthContext.Provider>\n  );\n};\n\nexport const useAuth = () => {\n  const context = useContext(AuthContext);\n  if (!context) {\n    throw new Error(\'useAuth must be used within an AuthProvider\');\n  }\n  return context;\n};\n"
    }
