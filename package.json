{
  "name": "music",
  "productName": "Music",
  "description": "Your music, gathered in one place.",
  "author": "Prahas",
  "private": true,
  "version": "1.0.0",
  "main": "electron-main.js",
  "homepage": "./",
  "build": {
    "appId": "com.prahas.music",
    "productName": "Music",
    "icon": "public/music-icon.png",
    "asar": true,
    "compression": "maximum",
    "files": [
      ".next/**/*",
      "public/**/*",
      "app/**/*",
      "components/**/*",
      "lib/**/*",
      "electron/**/*",
      "electron-main.js",
      "electron-next-server.js",
      "preload.js",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/*.log",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!test/**/*",
      "!tests/**/*",
      "!scripts/**/*",
      "!docs/**/*",
      "!screenshots/**/*",
      "!benchmark/**/*",
      "!.git/**/*",
      "!.github/**/*",
      "!data/**/*",
      "!dist/**/*",
      "!.next/cache/**/*",
      "!.next/standalone/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/app-builder-lib/**/*",
      "!node_modules/.cache/**/*"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Music",
      "include": "electron-builder-uninstall.nsh"
    }
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "electron:build": "npm run build",
    "electron:run": "electron .",
    "electron:dev": "electron . --dev",
    "electron": "npm run build && electron .",
    "electron:package": "npm run build && electron-builder --win",
    "electron:package:nobuild": "electron-builder --win",
    "spotify:poc": "electron electron/spotify/spotify-poc.cjs",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "bgutils-js": "^4.0.2",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.475.0",
    "next": "^16.3.2",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.34.5",
    "transliteration": "^2.3.5",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.8.1",
    "typescript": "^5.7.3"
  }
}
